sandbox/inv-cdip/
sandbox/inv-cdip.json
sandbox/inv-cdip-dev.json
sandbox/runs/*inv-cdip*

# Raw Textract responses for development sets, kept by score.py --cache. Local only.
sandbox/textract-cache/
